<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 运行时用 Activity.getTheme().applyStyle() 叠加，零布局改动即可全局生效。
         必须显式 parent=""：AAPT 会把含点号且未声明 parent 的 style 名解释为隐式继承，
         去查找逐级截短的同名前缀样式（如 ThemeOverlay.Aurora.Accent），找不到即链接失败。
         overlay 本身不需要继承任何父样式，此写法与项目既有
         ShapeAppearance.WebHTV.AudioCover 保持一致。 -->
    <style name="ThemeOverlay.Aurora.Accent.Jade" parent="">
        <item name="auroraAccent">#FF5FC79A</item>
        <item name="auroraAccentSoft">#FF1E3A30</item>
        <item name="colorPrimary">#FF5FC79A</item>
        <item name="colorSecondary">#FF5FC79A</item>
        <item name="colorControlActivated">#FF5FC79A</item>
    </style>
